# =====================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =====================================================================
# COPIE este arquivo para .env e preencha os valores reais:
#
#   cp .env.example .env
#
# NUNCA commite o .env real - ele está no .gitignore por segurança.
# Se você commitar por engano, avise o professor imediatamente.
# =====================================================================

# ---------- Django Core ----------
# Gerar nova chave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-pelo-menos-50-caracteres

# True apenas em desenvolvimento local. NUNCA True em produção.
DEBUG=True

# Domínios permitidos separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------- Banco de Dados ----------
# Em desenvolvimento: SQLite (padrão)
DATABASE_URL=sqlite:///db.sqlite3

# Em produção (Railway/Render/Fly/Neon): usar postgres
# DATABASE_URL=postgres://usuario:senha@host:5432/nomedb

# ---------- MongoDB Atlas (Banco NoSQL) ----------
# Obter em https://cloud.mongodb.com > seu cluster > Connect
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
# [CAMPO EM BRANCO - NOME DO PROJETO / BANCO NOSQL]:
MONGODB_DATABASE=

# ---------- Autenticação JWT (SimpleJWT) ----------
# Duração dos tokens (em minutos/dias)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------- Ambiente de Desenvolvimento & Login de Depuração ----------
LOGIN_DEBUG=True
LOGIN_DEBUG_USERNAME=devmaster
LOGIN_DEBUG_PASSWORD=devmaster_senha_dev_temporaria_123

# ---------- Criptografia de Tokens em Repouso (Fernet) ----------
# Chave mestra de criptografia (32 bytes URL-safe base64).
# Gerar chave: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=exemplo_chave_fernet_32_bytes_urlsafe_base64=

# ---------- Feature Flags & Modo Simulação Mock ----------
# Permite rodar e testar o fluxo de OAuth e Webhooks sem credenciais ativas de marketplace
SIMULAR_ROTAS_MOCK=True

# ---------- APIs Externas & Marketplaces (OAuth 2.0) ----------
# Mercado Livre - Infraestrutura Central / Hub
MERCADOLIVRE_CORE_CLIENT_ID=1234567890
MERCADOLIVRE_CORE_CLIENT_SECRET=sua_secret_mercadolivre_aqui
MERCADOLIVRE_REDIRECT_URI=https://seu-dominio-ou-ngrok.dev/marketplaces/mercadolivre/callback/

# Aliases compatíveis:
# MERCADOLIVRE_CLIENT_ID=1234567890
# MERCADOLIVRE_CLIENT_SECRET=sua_secret_mercadolivre_aqui

# APIs Externas Adicionais
VIACEP_URL=https://viacep.com.br/ws/

# ---------- Webhooks Globais por Canal (Modo Centralizado/Hub) ----------
MERCADOLIVRE_GLOBAL_WEBHOOK_SECRET=seu_webhook_secret_meli_aqui
SHOPEE_GLOBAL_WEBHOOK_SECRET=seu_webhook_secret_shopee_aqui
MAGALU_GLOBAL_WEBHOOK_SECRET=seu_webhook_secret_magalu_aqui

# ---------- E-mail (Opcional) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---------- Deploy / Produção ----------
# Se usar Railway/Render/Fly, essa variável é preenchida automaticamente
PORT=8000

# =====================================================================
# AVISO DE SEGURANÇA PARA AMBIENTES DE PRODUÇÃO:
# 1. As flags DEBUG e LOGIN_DEBUG DEVEM ser configuradas estritamente como False em produção.
# 2. O aplicativo 'apps.mockar_dados' é de uso exclusivo para testes e desenvolvimento.
# =====================================================================
